generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // PostgreSQL connection string (postgres:// or postgresql://)
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING       // Seats are held while the visitor completes SumUp Checkout
  CONFIRMED     // Paid (or free) and confirmed
  EXPIRED       // Checkout abandoned / expired, seats released
  CANCELLED     // Cancelled by the organiser or failed to start checkout
  NEEDS_REFUND  // Payment arrived after seats were released and no seats are left
}

enum DonationStatus {
  PENDING
  PAID
  EXPIRED
}

model Booking {
  id              String        @id @default(cuid())
  /// Public booking reference, e.g. SSV26-7K3QX9
  reference       String        @unique
  /// Random secret used in the confirmation link (so references alone cannot be used to view details)
  accessToken     String        @unique
  status          BookingStatus @default(PENDING)

  name            String
  email           String
  phone           String
  /// Normalised keys used to detect duplicate bookings
  emailKey        String
  phoneKey        String
  gothram         String?
  notes           String?

  yajamaniQty     Int           @default(0)
  generalQty      Int           @default(0)
  /// Amount payable in pence (Yajamani qty x price). 0 for free bookings.
  amountPence     Int           @default(0)

  /// SumUp checkout id, its hosted payment page URL and the resulting transaction code
  sumupCheckoutId    String?    @unique
  sumupCheckoutUrl   String?
  sumupTransactionId String?
  paidAt          DateTime?
  /// When a PENDING booking stops holding seats
  expiresAt       DateTime?
  emailSentAt     DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, expiresAt])
  @@index([emailKey])
  @@index([phoneKey])
}

model Donation {
  id              String         @id @default(cuid())
  reference       String         @unique
  accessToken     String         @unique
  status          DonationStatus @default(PENDING)

  name            String
  email           String
  message         String?
  amountPence     Int

  sumupCheckoutId    String?     @unique
  sumupCheckoutUrl   String?
  sumupTransactionId String?
  paidAt          DateTime?
  emailSentAt     DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
}

/// Single row (id = 1): ticket limits the organiser can change from /admin.
model EventSettings {
  id               Int      @id @default(1)
  yajamaniCapacity Int
  generalCapacity  Int
  updatedAt        DateTime @updatedAt
}
