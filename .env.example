# ------------------------------------------------------------------
# Copy this file to .env (local) and add the same values in Vercel
# (Project -> Settings -> Environment Variables). Never commit .env.
# ------------------------------------------------------------------

# --- Public site URL (no trailing slash). Used for the SumUp return/callback links and in emails. Must be a public https address in production.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# --- PostgreSQL (e.g. Neon, Supabase, Vercel Postgres, Prisma Postgres) ---
# Must start with postgres:// or postgresql://  (NOT prisma+postgres://).
# In Vercel paste the value only: no quotes, no spaces, no "DATABASE_URL=" in front.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Optional: a direct (non-pooled) URL used only for migrations. Leave unset if unsure.
# DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- SumUp (card payments) -------------------------------------------
# Sign in at https://me.sumup.com  ->  your profile  ->  Settings  ->  For Developers
#   ->  Toolkit  ->  API Keys  ->  Create.  Copy the key at once (SumUp shows it only once).
# It starts with sup_sk_ . Do NOT use the "Public Key" (sup_pk_...).
# Paste the value only: no quotes, no spaces, no "SUMUP_API_KEY=" in front (in Vercel).
SUMUP_API_KEY="sup_sk_..."
# Merchant code of the account that receives the money, e.g. MCXXXXXX.
# Shown next to your name / in the business drop-down at the top-left of the SumUp dashboard.
SUMUP_MERCHANT_CODE="MCXXXXXX"
# Test first with a SumUp SANDBOX merchant account (Settings -> For Developers -> Sandboxes):
# create the API key and read the merchant code while signed in to the sandbox account.
# There is no webhook secret: the callback address (/api/webhooks/sumup) is sent with each checkout.
# --- Email via Brevo (confirmation + donation receipt emails) --------
# 1. Create a free account at https://www.brevo.com (300 emails/day on the free plan).
# 2. API key: account menu -> Settings -> SMTP & API -> API Keys -> Generate a new API key.
#    Copy it at once (shown only once). It starts with xkeysib- . This is NOT the "SMTP key".
BREVO_API_KEY="xkeysib-..."
# 3. Sender: Settings -> Senders, Domains, IPs -> Senders -> Add a sender, then enter the 6-digit
#    code Brevo emails to that address. Best: authenticate your own domain (DKIM/DMARC) and use
#    an address on it, e.g. bookings@rsnv.org. A gmail.com/yahoo.com sender works but is much
#    more likely to land in spam. Do NOT use the "...@smtp-brevo.com" SMTP login here.
EMAIL_FROM_ADDRESS="bookings@your-domain.com"
# Name shown as the sender (optional)
EMAIL_FROM_NAME="Rugby Samuhika Satyanarayana Vratam 2026"
# Optional: also BCC every confirmation to the organisers
ORGANISER_NOTIFY_EMAIL=""
# --- Admin dashboard (/admin) ---------------------------------------
# If ADMIN_PASSWORD is empty the admin area is switched off.
ADMIN_USER="admin"
ADMIN_PASSWORD="choose-a-long-random-password"

# --- Organiser contact shown on the page (optional, add when known) --
NEXT_PUBLIC_ORGANISER_NAME=""
NEXT_PUBLIC_ORGANISER_EMAIL=""
NEXT_PUBLIC_ORGANISER_PHONE=""
