# ------------------------------------------------------------------
# Copy this file to .env (local) and add the same values in Vercel
# (Project -> Settings -> Environment Variables). Never commit .env.
# ------------------------------------------------------------------

# --- Public site URL (no trailing slash). Used in Stripe redirects and emails.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# --- PostgreSQL (e.g. Neon, Supabase, Vercel Postgres, Prisma Postgres) ---
# Must start with postgres:// or postgresql://  (NOT prisma+postgres://).
# In Vercel paste the value only: no quotes, no spaces, no "DATABASE_URL=" in front.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Optional: a direct (non-pooled) URL used only for migrations. Leave unset if unsure.
# DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Stripe ----------------------------------------------------------
# Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY="sk_test_..."
# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Email via your Gmail account -----------------------------------
# 1. Turn on 2-Step Verification for the Gmail account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
GMAIL_USER="yourname@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# Name shown as the sender (optional)
EMAIL_FROM_NAME="Samuhika Satyanarayana Vratam 2026"
# Optional: also BCC every confirmation to the organisers (can be the same Gmail)
ORGANISER_NOTIFY_EMAIL=""

# --- Admin dashboard (/admin) ---------------------------------------
# If ADMIN_PASSWORD is empty the admin area is switched off.
ADMIN_USER="admin"
ADMIN_PASSWORD="choose-a-long-random-password"

# --- Organiser contact shown on the page (optional, add when known) --
NEXT_PUBLIC_ORGANISER_NAME=""
NEXT_PUBLIC_ORGANISER_EMAIL=""
NEXT_PUBLIC_ORGANISER_PHONE=""
